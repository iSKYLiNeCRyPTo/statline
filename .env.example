# Copy this file to .env and fill in real values. Never commit .env.

# ── Halo / Xbox auth ─────────────────────────────────────────────────────────
# Spartan token for the Halo Infinite API. If MS_REFRESH_TOKEN is set, the
# server will auto-refresh this on a schedule.
SPARTAN_TOKEN=
# Microsoft refresh token used to mint new Spartan tokens. See README for how
# to obtain one (get_token_manual.html flow).
MS_REFRESH_TOKEN=

# ── Admin / calibration secrets (REQUIRED) ───────────────────────────────────
# Both must be set to strong, non-placeholder values (>= 12 chars; values like
# "changeme", "admin", "calibrate", "password" are rejected at startup).
# Generate with e.g.: `openssl rand -base64 24`
ADMIN_PASS=
CALIBRATE_KEY=

# ── Datastores ───────────────────────────────────────────────────────────────
REDIS_URL=
DATABASE_URL=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Set to "production" on Render / live deploys. In production, missing or weak
# admin/calibration secrets cause the server to refuse to start.
NODE_ENV=development

# Local dev escape hatch ONLY: when NODE_ENV != production, setting this to 1
# downgrades secret-validation errors to warnings. Never set this in production
# — it is ignored when NODE_ENV=production.
# ALLOW_DEV_INSECURE_SECRETS=0

# ── Background snapshot freshness gating ─────────────────────────────────────
# Controls how aggressively the background snapshot queue re-fetches players
# encountered as opponents/teammates of an explicit search. Conservative
# defaults; raise these to slow background traffic further.
# SNAPSHOT_RECENT_TTL_HOURS=24          # skip players refreshed in this window
# SNAPSHOT_STALE_RESCAN_DAYS=7          # rescan cadence for snapshotted players
# SNAPSHOT_NO_NEW_DATA_COOLDOWN_DAYS=14 # extra cooldown after consecutive empty refreshes
# SNAPSHOT_EMPTY_STRIKES=2              # empty refreshes before cooldown engages

# ── Active match-history recovery for private/reconstructed players ──────────
# When a private player's reconstructed coverage is below the threshold, the
# recovery queue fetches the match histories of their most-likely teammates
# and persists rows into match_participants. Staged depths concentrate the
# rate-limit budget on seeds that actually share matches with the target.
# RECOVERY_LOW_COVERAGE_THRESHOLD=40     # trigger recovery below this match count
# RECOVERY_MAX_SEEDS_PER_RUN=5           # cap seeds processed per target/run
# RECOVERY_CANDIDATE_POOL_SIZE=15        # how many candidates to pull from DB
# RECOVERY_STAGE1_DEPTH=100              # initial pass for every seed
# RECOVERY_STAGE2_DEPTH=250              # deeper pass for high-shared seeds
# RECOVERY_STAGE3_DEPTH=400              # deepest pass for very-high-shared seeds
# RECOVERY_STAGE2_SHARED_THRESHOLD=2     # stage1 shared hits required for stage2
# RECOVERY_STAGE3_SHARED_THRESHOLD=5     # stage2 shared hits required for stage3
# RECOVERY_PER_TARGET_COOLDOWN_HOURS=12  # don't re-run for same target inside this
# RECOVERY_HARD_CAP_MATCHES_PER_RUN=1500 # safety cap across all seeds in a run
# RECOVERY_INTER_SEED_DELAY_MS=1500      # pause between seeds (rate-limit cushion)
